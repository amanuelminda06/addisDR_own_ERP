# ---------------------------------------------------------------------------
# AddisDR ERP — environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL (Supabase) connection strings.
# DATABASE_URL is the pooled connection used by the running app — the Supabase
#   "Transaction" pooler URI (port 6543, host ...pooler.supabase.com, add
#   ?pgbouncer=true).
# DIRECT_URL is a non-pooled connection used by Prisma Migrate — the Supabase
#   "Session/direct" URI (port 5432, host db.<ref>.supabase.co).
DATABASE_URL="postgresql://postgres.REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:PASSWORD@db.REF.supabase.co:5432/postgres"

# Secret used to sign the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="replace-with-a-long-random-secret"

# Secret used by the background reminder cron job (see README → Scheduled
# reminders). The scheduler sends it as `Authorization: Bearer <CRON_SECRET>`.
# Vercel Cron does this automatically when this variable is set. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET="replace-with-a-long-random-secret"

# The single owner account created by `npm run db:seed`. You sign in with the
# username and password. Change the password immediately after first login.
OWNER_USERNAME="owner"
OWNER_EMAIL="owner@example.com"
OWNER_NAME="Owner"
OWNER_PASSWORD="change-me-now"
